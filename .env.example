# Local dev (docker-compose Postgres on port 5433)
DATABASE_URL="postgresql://app_user:app_dev_password@localhost:5433/transport_tms?schema=public"
DIRECT_DATABASE_URL="postgresql://tms:tms_dev_password@localhost:5433/transport_tms?schema=public"

# ---- Hosted DB: Supabase (free tier stays warm — no per-request cold start) ----
# Create a project at https://supabase.com (pick the Singapore region to match
# render.yaml's region), then from Project Settings -> Database copy:
#   - DATABASE_URL        = "Transaction" pooler string (port 6543) + pgbouncer flag
#   - DIRECT_DATABASE_URL = direct connection string (port 5432; used by migrations)
# NOTE: URL-encode special characters in the password (@ -> %40, # -> %23, etc.)
# and put REAL credentials only in .env (gitignored) — never in this file.
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
# DIRECT_DATABASE_URL="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres"

AUTH_SECRET="change-me"
UPLOAD_DIR="./data/uploads"
NEXT_PUBLIC_APP_NAME="TransportTMS"
